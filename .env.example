# Local development configuration for Tancode.
#
# NOTE: VS Code extensions do NOT load .env files automatically.
# These values are placeholders for local runtime configuration (for
# example, the address of a local inference runtime) and are read only
# by development tooling if and when code is added to consume them.
# Copy this file to .env and adjust values as needed. Never commit real
# credentials — Tancode is local-first and uses no external AI services.

# Address of the local Ollama runtime (future use; no code reads this yet).
TANCODE_MODEL_ENDPOINT=http://localhost:11434

# Open-weight model identifier served by the local runtime (future use).
TANCODE_MODEL=qwen3:8b-q4_K_M
